{
  "manifest_version": 3,
  "name": "StockAlert.pro",
  "short_name": "StockAlert",
  "version": "1.2.0",
  "description": "Detect stock tickers while browsing and create price alerts or add symbols to your StockAlert.pro watchlist.",
  "homepage_url": "https://stockalert.pro",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "StockAlert.pro",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.stockalert.pro/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
